{
  "name": "ggpos",
  "private": true,
  "version": "0.1.0",
  "description": "GG Vault: inventory, trade-in, loyalty and customer system for GG Entertainment",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md,yml,yaml}\"",
    "pb": "bash pb/scripts/dev.sh",
    "typegen": "bash pb/scripts/typegen.sh",
    "e2e": "playwright test",
    "e2e:build": "pnpm --filter web build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "@types/node": "^22"
  }
}
