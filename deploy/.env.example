# GG Vault - environment file for the VPS.
#
# Copy this to deploy/.env and fill in real values:
#   cp deploy/.env.example deploy/.env
#
# deploy/.env holds real secrets. It is never committed (see the root
# .gitignore and deploy/.gitignore) and should not leave the VPS, other
# than a backup copy of RESTIC_PASSWORD in a password manager - see the
# note on that variable below.
#
# Formatting rule, because this one file is read two different ways:
#   - docker-compose.yml loads it as `env_file` for both services. Compose's
#     own parser does NOT strip quotes and does NOT expand $variables, so
#     PASSWORD="abc" would literally set the value to abc" (quotes and all).
#   - deploy/backup.sh loads it with bash's `source`, which DOES interpret
#     quotes, $ and backticks as shell syntax.
# To keep both readings identical: never wrap a value in quotes, and never
# put a space, $, backtick, quote character, or < or > inside a value (the
# last two are shell redirection to bash, even mid-word with nothing either
# side of them). Generate secrets as plain hex/base64url text, e.g.
# `openssl rand -hex 32`.

# -----------------------------------------------------------------------
# PocketBase (the "pocketbase" service)
# -----------------------------------------------------------------------

# PocketBase version to build - matches pb/Dockerfile's `ARG PB_VERSION`.
# Bump this to upgrade PocketBase without editing the Dockerfile.
PB_VERSION=0.40.4

# Symmetric key pb_hooks uses to encrypt ID photos before they touch disk
# (docs/PLAN.md, "Security, GDPR and record keeping"). Generate ONE value
# with `openssl rand -hex 32` and keep a copy in the password manager:
# losing this key makes every stored ID photo permanently unreadable.
GG_ID_PHOTO_KEY=replace-with-the-output-of-openssl-rand-hex-32

# The shop's first PocketBase superuser (platform admin, used to sign in
# at /_/). Used the first time the stack starts - see deploy/README.md,
# "Creating the superuser". Change the password after first login and
# turn on MFA straight away.
GG_ADMIN_EMAIL=admin@ggentertainment.co.uk
GG_ADMIN_PASSWORD=change-me-to-a-long-random-password

# -----------------------------------------------------------------------
# pricesync (the "pricesync" service)
# -----------------------------------------------------------------------

# A PocketBase superuser pricesync logs in as to write price_snapshots
# through the batch API (docs/PLAN.md, "pricesync sidecar"). This can be
# the same account as GG_ADMIN_EMAIL/GG_ADMIN_PASSWORD above, or its own
# dedicated superuser created later - either works, nothing else assumes
# they are the same account.
PB_SUPERUSER_EMAIL=pricesync@ggentertainment.co.uk
PB_SUPERUSER_PASSWORD=change-me-to-a-long-random-password

# -----------------------------------------------------------------------
# Backups (deploy/backup.sh)
# -----------------------------------------------------------------------
# restic reads these three itself - nothing in this repo needs to name
# them again. RESTIC_REPOSITORY points at an S3-compatible bucket; the
# example below is Cloudflare R2, a Backblaze B2 "S3 compatible" endpoint
# works the same way.

RESTIC_REPOSITORY=s3:https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com/ggvault-backups

# The restic encryption password. This is the single most important
# secret in this file: restic encrypts every backup with it client-side
# before upload, so without this password the backups sitting in R2/B2
# are unreadable ciphertext, including to us. Generate it once
# (`openssl rand -base64 32`), keep it in the password manager, and do
# not treat this file as the only copy of it - see deploy/restore.md.
RESTIC_PASSWORD=replace-with-a-long-random-password-also-kept-in-the-password-manager

# S3-compatible credentials for the bucket above (an R2 API token, or a
# B2 application key with S3 compatibility turned on).
AWS_ACCESS_KEY_ID=replace-with-the-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-the-secret-access-key

# R2 does not use regions - "auto" is correct. For B2, use the region
# shown next to the bucket in its dashboard, e.g. eu-central-003.
AWS_DEFAULT_REGION=auto
