{
  "name": "@gg/shared",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:hooks": "rm -rf ../../pb/pb_hooks/lib/shared && tsc -p tsconfig.hooks.json && node ./scripts/stamp-hooks.mjs",
    "check:hooks": "pnpm build:hooks && git diff --exit-code -- ../../pb/pb_hooks/lib/shared"
  },
  "devDependencies": {
    "typescript": "~6",
    "vitest": "^4"
  }
}
