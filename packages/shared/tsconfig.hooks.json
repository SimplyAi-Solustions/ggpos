{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node10",
    "target": "ES2017",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "../../pb/pb_hooks/lib/shared",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "isolatedModules": false,
    "types": [],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/pb-types.ts",
    "src/index.ts"
  ]
}
